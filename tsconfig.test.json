{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["node", "vite/client", "vitest/globals"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@dice/game-domain": ["./packages/game-domain/src/index.ts"],
      "@dice/physics-core": ["./packages/physics-core/src/index.ts"],
      "@dice/physics-core/*": ["./packages/physics-core/src/*"],
      "@dice/protocol": ["./packages/protocol/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.test.ts",
    "apps/**/*.test.tsx",
    "apps/web/src/__tests__/setup.ts",
    "packages/**/__tests__/**/*.ts",
    "e2e/**/*.ts"
  ]
}

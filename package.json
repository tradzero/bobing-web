{
  "name": "dice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "vite-node --config apps/server/vite.config.ts apps/server/src/index.ts",
    "build": "pnpm run build:web && pnpm run build:server",
    "build:web": "tsc -b && vite build",
    "build:server": "vite build --config apps/server/vite.config.ts",
    "start": "node dist-server/index.js",
    "db:migrate": "vite-node --config apps/server/vite.config.ts apps/server/src/db/migrate-cli.ts",
    "build:e2e": "vite build --mode e2e",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4173 --strictPort --mode e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "pnpm run build:e2e",
    "test:e2e": "playwright test e2e/game.spec.ts",
    "pretest:e2e:soak": "pnpm run build:e2e",
    "test:e2e:soak": "playwright test e2e/soak.spec.ts --grep @soak-default",
    "pretest:e2e:soak:legacy": "pnpm run build:e2e",
    "test:e2e:soak:legacy": "playwright test e2e/soak.spec.ts --grep @soak-legacy-rollback",
    "prebench:browser": "pnpm run build:e2e",
    "bench:browser": "playwright test e2e/browser-bench.spec.ts",
    "prebench:browser:render-ab": "pnpm run build:e2e",
    "bench:browser:render-ab": "playwright test e2e/render-performance-ab.spec.ts",
    "prebench:browser:physics-scheduler-ab": "pnpm run build:e2e",
    "bench:browser:physics-scheduler-ab": "playwright test e2e/physics-scheduler-ab.spec.ts",
    "prebench:browser:collision-ab": "pnpm run build:e2e",
    "bench:browser:collision-ab": "playwright test e2e/physics-collision-ab.spec.ts",
    "test:physics": "vitest run apps/web/src/__tests__/physics-acceptance.test.ts apps/web/src/__tests__/floor-relaunch.test.ts apps/web/src/__tests__/physics-smoke.test.ts apps/web/src/__tests__/dice-escape.test.ts apps/web/src/__tests__/freeze-consistency.test.ts apps/web/src/__tests__/contact-cluster-assist.test.ts apps/web/src/__tests__/settle.test.ts",
    "test:seed": "vite-node scripts/physics-acceptance.ts",
    "test:acceptance": "vite-node scripts/physics-acceptance.ts --seeds=200",
    "test:physics:ab": "vite-node scripts/physics-ab.ts",
    "test:physics:cadence": "vite-node scripts/physics-cadence.ts",
    "sweep:param": "vite-node sweep/param-sweep.ts",
    "sweep:sleep": "vite-node sweep/sleep-sweep.ts",
    "sweep:timeout": "vite-node sweep/timeout-risk.ts",
    "sweep:jitter": "vite-node sweep/jitter-diagnose.ts",
    "sweep:tilt": "vite-node sweep/tilt-stats.ts",
    "sweep:bench": "vite-node sweep/shape-bench.ts",
    "sweep:contact-eq": "vite-node sweep/contact-equation-sweep.ts",
    "sweep:contact-grid": "vite-node sweep/contact-equation-grid.ts",
    "sweep:contact-validate": "vite-node sweep/contact-equation-validate.ts",
    "sweep:solver-ab": "vite-node sweep/solver-ab.ts",
    "sweep:parallel": "node scripts/run-sweeps.mjs",
    "sweep:parallel:core": "node scripts/run-sweeps.mjs sleep timeout tilt"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "pg": "^8.23.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sirv": "^3.0.2",
    "three": "^0.183.2",
    "ws": "^8.21.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.4"
  }
}

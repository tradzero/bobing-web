# PostgreSQL 是多人房间的权威持久层；服务不会自行启动数据库。
DATABASE_URL=postgresql://dice:change-me@127.0.0.1:5432/dice

SERVER_HOST=0.0.0.0
SERVER_PORT=8787
# 服务启动时确保该永久开放房存在；可从大厅通过对应链接进入。
DEFAULT_ROOM_ID=default
MAX_ROOM_PLAYERS=12
# Web 构建时变量；默认启用多人入口，根路径显示房间大厅。
VITE_MULTIPLAYER_ENABLED=true

# 全部时间单位为毫秒；普通/加投操作时限不得低于 10 秒。
TURN_ACTION_TIMEOUT_MS=30000
TILT_DECISION_TIMEOUT_MS=10000
END_DECISION_TIMEOUT_MS=30000
# 权威物理错误或倾斜确认超时后，服务端最多自动换 seed 重投次数。
MAX_AUTO_RETRIES=1
SCHEDULER_POLL_INTERVAL_MS=500
ROLL_REVEAL_MIN_MS=1200
ROLL_REVEAL_MAX_MS=10000
# 权威物理固定并发、等待队列上限；计算超时包含排队时间。
ROLL_WORKERS=2
ROLL_QUEUE_LIMIT=32
ROLL_COMPUTE_TIMEOUT_MS=10000

# 房间生命周期：空房 1 小时删除；进行中 30 分钟无真实操作则废弃；
# lobby/结束/废弃房在无在线心跳且 24 小时无活动后归档，归档 7 天后删除。
EMPTY_ROOM_TTL_MS=3600000
GAME_IDLE_ABANDON_MS=1800000
ROOM_IDLE_ARCHIVE_MS=86400000
ARCHIVED_ROOM_RETENTION_MS=604800000
ROOM_LIFECYCLE_POLL_INTERVAL_MS=60000

DB_POOL_MAX=10
AUTO_MIGRATE=false
